# Copy this file to application.properties and fill in your own values.
# application.properties itself is gitignored so your real credentials never get pushed.

spring.datasource.url=jdbc:mysql://localhost:3306/my_spring_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

server.port=8080
